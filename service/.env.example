# Copy to service/.env (gitignored) for docker compose, or set these in Render / Railway.
# Never commit real values.

# The shared secret the Node backend sends as X-API-Key. Generate one, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_API_KEY=change-me

# Where the bundle comes from. In docker compose the default serves ./local/serve_bundle.tar.gz
# through the bundle-host container; on Render use the GitHub Release asset:
# BUNDLE_URL=https://github.com/Aniketdhar810/litsense-model/releases/download/bundle-v0-20261020/serve_bundle.tar.gz
BUNDLE_DIR=/var/litsense

# Turns the Gemini explanations and chat on; without it every route answers with templates.
GEMINI_API_KEY=

LOG_LEVEL=INFO
ONNX_THREADS=1

# Optional knobs (defaults shown)
# CORE_THREADS=4
# RECOMMEND_CONCURRENCY=2
# QUEUE_TIMEOUT_S=10
# RATE_LIMIT_RPS=20
# RATE_LIMIT_BURST=40
# LLM_TIMEOUT_S=12
# CACHE_TTL_S=300
# CACHE_MAX_ENTRIES=1024
# MAX_BODY_BYTES=1000000
# CORS_ORIGINS=
# ALLOW_NO_AUTH=false
